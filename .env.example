# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Apify Console -> Settings -> API & Integrations
APIFY_API_TOKEN=
APIFY_ACTOR_ID=fanndev/topjobs-lk-scraper

# Cost controls
APIFY_MEMORY_MB=256
APIFY_FALLBACK_MEMORY_MB=1024
APIFY_TIMEOUT_SECS=120
CACHE_TTL_HOURS=6

# Abuse protection (0 disables a limit)
RATE_LIMIT_COOLDOWN_SECS=10
RATE_LIMIT_SEARCHES_PER_HOUR=20
# Searches that start a NEW Actor run (cache hits don't count)
RATE_LIMIT_USER_RUNS_PER_DAY=5
# Hard cap on Actor runs across all users per 24h (also applies to admins)
RATE_LIMIT_GLOBAL_RUNS_PER_DAY=200
# Comma-separated Telegram user IDs exempt from per-user limits
ADMIN_USER_IDS=

# Optional
# true = location, job type and short description (slower; no extra billed event)
# false = compact rows with posted date only (faster)
APIFY_FETCH_FULL_DETAILS=true
DATABASE_PATH=jobbot.sqlite3
LOG_LEVEL=INFO
