# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Job sites
TOPJOBS_ENABLED=true
# Search within this TopJobs category (SDQ = IT software). Leave empty to search all jobs by keyword.
TOPJOBS_CATEGORY=SDQ
# Send each job's ad image (downloaded once, then reused via Telegram's file_id)
SEND_JOB_IMAGES=true
# XpressJobs' terms forbid scraping without permission.
# Set to true ONLY after XpressJobs has given you written permission.
XPRESSJOBS_ENABLED=false

# Politeness towards the sites
# Minimum gap between two requests to the same site (all users combined)
SCRAPE_MIN_INTERVAL_SECS=2
HTTP_TIMEOUT_SECS=20
# How long one site's results for a keyword are reused for everyone
CACHE_TTL_HOURS=6
# Retries for timeouts / 5xx (waits 2s, 4s, ...)
HTTP_RETRIES=2
# When a site answers 403/429, stop asking it for this long (or its Retry-After, if longer)
SITE_BACKOFF_MINUTES=30
# If a site can't be reached, show its cached results up to this old (marked "may be outdated")
STALE_CACHE_MAX_HOURS=48
# Alert admins after this many failures in a row (403/429 alert immediately)
ALERT_AFTER_FAILURES=3
# Optional: identify the bot to the sites (default: TopJobsTelegramBot/1.0 (+https://t.me/TopJobsSearch_Bot))
# SCRAPER_USER_AGENT=

# Abuse protection (0 disables a limit)
RATE_LIMIT_COOLDOWN_SECS=10
RATE_LIMIT_SEARCHES_PER_HOUR=20
# Searches that have to contact the sites (cache hits don't count)
RATE_LIMIT_USER_FETCHES_PER_DAY=30
# Hard cap across all users per 24h (also applies to admins)
RATE_LIMIT_GLOBAL_FETCHES_PER_DAY=500
# Comma-separated Telegram user IDs: exempt from per-user limits AND receive site alerts.
# Get your ID from @userinfobot, and press /start in your bot once so it can message you.
ADMIN_USER_IDS=

# Optional: users must join this channel before using the bot (@channelname, or -100... for a
# private channel). The bot must be an admin of the channel. Leave empty to let anyone use it.
REQUIRED_CHANNEL=
# Join button link; required for a private channel (its invite link, https://t.me/+...)
REQUIRED_CHANNEL_LINK=

# Optional
DATABASE_PATH=jobbot.sqlite3
LOG_LEVEL=INFO
